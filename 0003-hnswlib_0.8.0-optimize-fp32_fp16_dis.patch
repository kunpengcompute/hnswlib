+/* FP16 distance calculation */
+static float
+InnerProductPh(const void *pVect1, const void *pVect2, const void *qty_ptr) {
+    float16_t *x = (float16_t *) pVect1;
+    float16_t *y = (float16_t *) pVect2;
+    size_t qty = *((size_t *) qty_ptr);
+    float res = 0;
+    for (size_t i = 0; i < qty; i++) {
+        res += (float)(*x) * (float)(*y);
+        x++;
+        y++;
+    }
+    return res;
+}
