+static float
+InnerProductPhSIMD4ExtNEON(const void *pVect1v, const void *pVect2v, const void *qty_ptr) {
+    float16_t *x = (float16_t *) pVect1v;
+    float16_t *y = (float16_t *) pVect2v;
