+std::vector<float> generate_random_vector(size_t n, float min = -1.0f, float max = 1.0f)
+{
+    std::vector<float> vec(n);
+    for (size_t i = 0; i < n; ++i) {
+        float val = min + static_cast<float>(rand()) / RAND_MAX * (max - min);
+        vec[i] = val;
+    }
+    return vec;
+}
