+    float16x8_t y8_0 = vld1q_f16(y);
+    float16x8_t y8_1 = vld1q_f16(y + 8);
+
+    res0 = vfmlalq_low_f16(res0, x8_0, y8_0);
+    res1 = vfmlalq_low_f16(res1, x8_1, y8_1);
+
+    res0 = vfmlalq_high_f16(res0, x8_0, y8_0);
+    res1 = vfmlalq_high_f16(res1, x8_1, y8_1);
+
+    for (i = single_round; i <= qty - single_round; i += single_round) {
+        x8_0 = vld1q_f16(x + i);
+        y8_0 = vld1q_f16(y + i);
+        res0 = vfmlalq_low_f16(res0, x8_0, y8_0);
+        res0 = vfmlalq_high_f16(res0, x8_0, y8_0);
+
+        x8_1 = vld1q_f16(x + i + 8);
+        y8_1 = vld1q_f16(y + i + 8);
+        res1 = vfmlalq_low_f16(res1, x8_1, y8_1);
+        res1 = vfmlalq_high_f16(res1, x8_1, y8_1);
+    }
+    res0 = vaddq_f32(res0, res1);
+    res = vaddvq_f32(res0);
+
+    return (res);
+}
+
+static float
