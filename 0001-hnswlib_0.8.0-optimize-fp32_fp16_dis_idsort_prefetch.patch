+            bfs_push(i);
+        }
+
+        if (place_deleted_last) {
+            for (tableint i = 0; i < N; ++i) {
+                if (!is_active[i]) {
+                    order.push_back(i);
+                }
+            }
+        } else {
+            std::vector<char> seen(N, 0);
+            for (auto x : order) {
+                seen[x] = 1;
+            }
+            for (tableint i = 0; i < N; ++i) {
+                if (!seen[i]) {
